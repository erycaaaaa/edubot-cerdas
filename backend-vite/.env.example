# ==============================================================================
# EduBuz Backend Express - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WAJIB UNTUK STARTUP SERVER
# ------------------------------------------------------------------------------
# URL project Supabase (misal: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key Supabase (HANYA di backend, jangan diberikan ke frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Port server Express (Otomatis disediakan oleh Railway sebagai $PORT)
PORT=5000

# ------------------------------------------------------------------------------
# 2. WAJIB UNTUK FITUR TERTENTU
# ------------------------------------------------------------------------------
# URL Reward & Gamification API (Python FastAPI di Railway)
GAMIFICATION_API_URL=https://edubot-cerdas-production.up.railway.app

# URL Moderation API (Toxicity Classifier service)
MODERATION_API_URL=http://127.0.0.1:8000

# URL Generator API (LLM/Qwen Text Generation service)
GENERATOR_API_URL=http://127.0.0.1:8001

# URL publik aplikasi frontend (Digunakan saat admin mengundang guru via email)
# Format URL lengkap: https://domain-frontend.com
APP_URL=http://localhost:5175

# Origin yang diizinkan oleh CORS (Pisahkan dengan koma jika lebih dari satu)
# Wajib mencakup domain frontend produksi agar browser tidak diblokir 403.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ------------------------------------------------------------------------------
# 3. OPSIONAL (PENGATURAN TIMEOUT & API KEY)
# ------------------------------------------------------------------------------
# API Key untuk Reward API (jika REWARD_API_KEY diaktifkan di Python service)
# GAMIFICATION_API_KEY=your-gamification-api-key

# Timeout HTTP request ke Gamification API dalam milidetik (default: 10000 = 10 detik)
# GAMIFICATION_TIMEOUT=10000

# API Key untuk Moderation API (jika service moderasi memvalidasi key)
# MODERATION_API_KEY=your-moderation-api-key

# Timeout HTTP request ke Moderation API dalam milidetik (default: 30000 = 30 detik)
# MODERATION_TIMEOUT=30000

# API Key untuk Generator API
# GENERATOR_API_KEY=your-generator-api-key

# Timeout HTTP request ke Generator API dalam milidetik (default: 180000 = 3 menit)
# GENERATOR_TIMEOUT=180000

# ------------------------------------------------------------------------------
# 4. CATATAN PENTING: VARIABEL YANG TIDAK DIGUNAKAN DI BACKEND
# ------------------------------------------------------------------------------
# SUPABASE_ANON_KEY tidak digunakan di Backend Express.
# Frontend menggunakan VITE_SUPABASE_ANON_KEY di browser klien.

