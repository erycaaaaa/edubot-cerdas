{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-vite": {
      "root": "backend-vite",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "frontend-vite": {
      "root": "frontend-vite",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend-vite"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend-vite"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend-vite"
      }
    }
  ]
}
